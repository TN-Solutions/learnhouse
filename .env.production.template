# LearnHouse Production Environment Configuration
# Copy this file to .env.production and fill in your values

# ===========================================
# EXTERNAL SERVICES CONFIGURATION
# ===========================================

# PostgreSQL Database Connection
POSTGRES_URL=postgresql://username:password@your-postgres-host:5432/learnhouse_prod
LEARNHOUSE_SQL_CONNECTION_STRING=${POSTGRES_URL}

# Redis Connection
REDIS_URL=redis://your-redis-host:6379
LEARNHOUSE_REDIS_CONNECTION_STRING=${REDIS_URL}

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Environment
ENVIRONMENT=production
NODE_ENV=production

# API Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com:9000

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-here

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://your-domain.com

# ===========================================
# STORAGE CONFIGURATION
# ===========================================

# AWS S3 Configuration (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# Resend Email Service
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@your-domain.com

# ===========================================
# AI SERVICES CONFIGURATION
# ===========================================

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# ===========================================
# PAYMENT CONFIGURATION
# ===========================================

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ===========================================
# MONITORING CONFIGURATION
# ===========================================

# Logfire (if using)
LOGFIRE_TOKEN=your-logfire-token

# ===========================================
# DOMAIN CONFIGURATION
# ===========================================

# Your domain name
DOMAIN=your-domain.com

# SSL Certificate Path (if using custom SSL)
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

# ===========================================
# DEVELOPMENT/OPTIONAL CONFIGURATION
# ===========================================

# Enable debug mode (not recommended for production)
DEBUG=false

# Log level (ERROR, WARN, INFO, DEBUG)
LOG_LEVEL=INFO

# Enable telemetry
NEXT_TELEMETRY_DISABLED=1